# 统一换行符为 LF：避免 Windows 上的 "LF will be replaced by CRLF" 警告，
# 也保证不同平台克隆下来的文件内容一致。
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.svg  text
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.mp3  binary
*.mp4  binary

# 打包发布时排除
.github/   export-ignore
.gitignore export-ignore
